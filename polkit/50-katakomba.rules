// Katakomba — règle polkit.
//
// Les membres du groupe « katakomba » démarrent, arrêtent et redémarrent
// katakomba.service sans mot de passe, depuis leur session locale active
// (bouton « Se connecter » de l'interface).
//
// Rien d'autre : un autre service, le démarrage automatique (enable/disable)
// ou la réparation du réseau demandent toujours le mot de passe
// administrateur.  Arrêter le service lève le blocage hors tunnel et rend la
// connexion normale : l'interface signale tout arrêt non demandé.
polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units"
            || action.lookup("unit") !== "katakomba.service") {
        return polkit.Result.NOT_HANDLED;
    }
    var verbe = action.lookup("verb");
    if (verbe !== "start" && verbe !== "stop" && verbe !== "restart") {
        return polkit.Result.NOT_HANDLED;
    }
    if (subject.local && subject.active && subject.isInGroup("katakomba")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
