#!/bin/sh
# Avant le retrait des fichiers : arrêt du service et nettoyage du système
# (règles pare-feu, unité, hook de veille).  Une mise à jour ne retire rien :
# le postinst de la nouvelle version reconfigure et relance.
set -e
case "$1" in
    remove|deconfigure)
        # Remplacé par l'autre variante (katakomba ↔ katakomba-headless) :
        # son postinst reconfigure et relance le service — rien à défaire.
        if [ "${2:-}" = "in-favour" ]; then
            exit 0
        fi
        bash /opt/katakomba/uninstall.sh --paquet || true
        ;;
esac
exit 0
