#!/bin/sh
# « apt purge » : réglages, fournisseurs, comptes et données Tor effacés.
# « apt remove » les conserve pour une réinstallation.
set -e
case "$1" in
    purge)
        # L'autre variante (katakomba ↔ katakomba-headless) est installée :
        # réglages et code sont aussi les siens.  Une variante remplacée reste
        # « à purger » (rc) : la purger plus tard ne doit rien effacer.
        if [ -e /opt/katakomba/constants.py ]; then
            exit 0
        fi
        rm -rf /etc/katakomba /var/lib/katakomba /opt/katakomba
        userdel katakomba-vpn 2>/dev/null || true
        groupdel katakomba-vpn 2>/dev/null || true
        groupdel katakomba-statut 2>/dev/null || true
        groupdel katakomba 2>/dev/null || true
        ;;
esac
exit 0
